-->
<component type="desktop-application">
  <id>@KWI_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@KWI_PROJECT_LICENSE@</project_license>
  <name>@KWI_DISPLAY_NAME@</name>
  <developer id="@KWI_APP_ID@"><name>Mohamed Elashri and contributors</name></developer>
  <summary>A fast terminal with bidirectional text support</summary>
  <description>
    <p>Zirq is an independently maintained terminal for macOS, based on KDE Kwi, with Arabic, Persian and Hebrew support.</p>
  </description>
  <url type="homepage">https://github.com/MohamedElashri/zirq</url>
  <url type="vcs-browser">https://github.com/MohamedElashri/zirq</url>
  <launchable type="desktop-id">@KWI_APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/MohamedElashri/zirq/main/assets/readme/screenshot.png</image>
    </screenshot>
  </screenshots>
  <provides><binary>@KWI_EXECUTABLE@</binary></provides>
  <translation type="gettext">kwi</translation>
  <releases>
    <release version="0.3.3" date="2026-11-23" type="stable">
      <description>
        <p>Keep the Ko-fi tip button visible in About, add it to Help, and link to the main software catalog.</p>
      </description>
    </release>
    <release version="0.3.2" date="2026-11-23" type="stable">
      <description>
        <p>Refresh About with project links and an optional Ko-fi tip link.</p>
      </description>
    </release>
    <release version="0.3.1" date="2026-11-20" type="stable">
      <description>
        <p>Integrate KDE Kwi upstream fixes and improvements, including rendering, tabs, selection, and terminal session handling. Update libghostty-vt to 1.0.1 while preserving existing Zirq settings and bidirectional text support.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
